ECOAR_TOKEN_NO_03=troque-me
ECOAR_TOKEN_NO_04=troque-me
ECOAR_TOKEN_NO_05=troque-me
ECOAR_TOKEN_OPERADOR=troque-me
ECOAR_TOKEN_ADMIN=troque-me
