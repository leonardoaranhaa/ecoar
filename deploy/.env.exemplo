# Modelo do .env da demo em VPS. NÃO edite este arquivo para uso real:
# rode ./gerar-env.sh, que cria um .env com tokens fortes de verdade.
#
# Estes valores são só ilustrativos e curtos demais de propósito — o backend
# recusa token com menos de 16 caracteres.

ECOAR_TOKEN_BAURU_01=troque-me
ECOAR_TOKEN_BAURU_02=troque-me
ECOAR_TOKEN_BAURU_03=troque-me
ECOAR_TOKEN_PIRA_01=troque-me
ECOAR_TOKEN_PIRA_02=troque-me
ECOAR_TOKEN_PIRA_03=troque-me
ECOAR_TOKEN_MARILIA_01=troque-me
ECOAR_TOKEN_MARILIA_02=troque-me

ECOAR_TOKEN_OPERADOR=troque-me
ECOAR_TOKEN_ADMIN=troque-me
